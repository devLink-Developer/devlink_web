# Local/host runtime; do not copy private files into the repository or MEDIA_ROOT.
BILLING_CERTIFICATE_ROOT=/run/devlink-arca
BILLING_CERTIFICATE_ROOT_HOST=/opt/private/devlink-arca
BILLING_ALLOW_PRODUCTION=False
BILLING_NETWORK_ENABLED=True
BILLING_ARCHIVE_ROOT=/home/appuser/.local/share/devlink/invoices
# If using an encrypted key or PFX, define a secret in the server environment,
# then enter only its variable name in the configuration form.
